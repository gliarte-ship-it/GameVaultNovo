rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource == null ? null : resource.data;
    }

    // --- Game Validation ---
    function isValidGame(data) {
      return data.keys().hasAll(['title', 'platform', 'status', 'ownerId', 'createdAt', 'updatedAt'])
        && data.keys().size() <= 9 // Optional fields: rating, image, description
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.platform is string && data.platform.size() > 0 && data.platform.size() <= 100
        && data.status in ['Jogando', 'Pendente', 'Zerado', 'Abandonado']
        && data.ownerId == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('rating' in data) || (data.rating is number && data.rating >= 0 && data.rating <= 10))
        && (!('image' in data) || (data.image is string && data.image.size() <= 2000))
        && (!('description' in data) || (data.description is string && data.description.size() <= 5000));
    }

    // --- Routes ---
    match /games/{gameId} {
      allow get: if isOwner(existing().ownerId) && isValidId(gameId);
      
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      allow create: if isSignedIn() 
        && isValidId(gameId)
        && isValidGame(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(existing().ownerId)
        && isValidId(gameId)
        && isValidGame(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: General Update
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'platform', 'status', 'rating', 'image', 'description', 'updatedAt'])
        );

      allow delete: if isOwner(existing().ownerId) && isValidId(gameId);
    }
  }
}
