{
  "entities": {
    "Game": {
      "title": "Jogo",
      "description": "Um jogo na coleção do usuário",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Título do jogo" },
        "platform": { "type": "string", "description": "Plataforma (ex: PC, PS5, Switch)" },
        "status": { "type": "string", "enum": ["Jogando", "Pendente", "Zerado", "Abandonado"], "description": "Status atual do jogo" },
        "rating": { "type": "number", "description": "Nota dada pelo usuário (0-10)" },
        "image": { "type": "string", "description": "URL da imagem de capa" },
        "description": { "type": "string", "description": "Resumo ou detalhes do jogo" },
        "ownerId": { "type": "string", "description": "UID do dono do registro" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Data de criação" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Data de atualização" }
      },
      "required": ["title", "platform", "status", "ownerId"]
    }
  },
  "firestore": {
    "games/{gameId}": {
      "schema": "Game",
      "description": "Coleção principal de jogos"
    }
  }
}
